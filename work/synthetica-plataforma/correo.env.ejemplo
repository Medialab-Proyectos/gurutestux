# Copia este archivo como .env (queda fuera de git) y completa UNA de las dos opciones.
# El servidor local solo envía al equipo: hello@medialab.design.

# --- Opción A: SendGrid ---------------------------------------------------
# CORREO_PROVEEDOR=sendgrid
# CORREO_REMITENTE=estudios@medialab.design      # remitente verificado en SendGrid
# SENDGRID_API_KEY=SG.xxxxx                       # clave con permiso «Mail Send»

# --- Opción B: cualquier SMTP (Google Workspace, Zoho, etc.) --------------
# CORREO_PROVEEDOR=smtp
# CORREO_REMITENTE=estudios@medialab.design
# SMTP_SERVIDOR=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_USUARIO=estudios@medialab.design
# SMTP_CLAVE=contraseña-de-aplicacion
